<%- include('../../partials/head.html') %>

<body>
<div class="container">
    <%- include('../../partials/header.html') %>
   <div>
       <h2>Create Game</h2>
       <form action="/game" method="POST">
           <div class="formItem">
           <label for="name">Name: </label>
           <input id="name" name="name" required/>
           </div>

           <div class="formItem">

           <label for="size">Map size: </label>
           <select id="size" name="size">
               <option value="10">10x10</option>
               <option value="20">20x20</option>
               <option value="30">30x30</option>
               <option value="40">40x40</option>
           </select>
           </div>

           <div class="formItem">
           <label for="turnTime">Actions Interval: </label>
           <select id="turnTime" name="turnTime">
               <option value=24>24 hours</option>
               <option value=12>12 hours</option>
               <option value=6>6 hours</option>
               <option value=4>4 hours</option>
               <option value=3>3 hours</option>
               <option value=2>2 hours</option>
               <option value=1>1 hour</option>
           </select>
           </div>

           <div class="formItem">
           <label for="actionsPerInterval">Action Amount:</label>
           <select id="actionsPerInterval" name="actionsPerInterval">
               <option value=1>1</option>
               <option value=2>2</option>
               <option value=3>3</option>
               <option value=4>4</option>
               <option value=5>5</option>
               <option value=6>6</option>
           </select>
           </div>

           <div class="formItem">
           <label for="doActionQueue">Mode</label>
           <select id="doActionQueue" name="doActionQueue">
               <option value="false">Asynchronous</option>
               <option value="true">Rounds (action queue)</option>
           </select>
           </div>

           <div class="formItem" id="broadcastRow">
               <label for="doBroadcastAction">Broadcast queued actions (spying)</label>
               <input type="hidden" name="doBroadcastAction" value="false" />
               <input id="doBroadcastAction" type="checkbox" name="doBroadcastAction" value="true" checked />
           </div>

           <div class="formItem">
               <label for="doFogOfWar">Fog of war</label>
               <input type="hidden" name="doFogOfWar" value="false" />
               <input id="doFogOfWar" type="checkbox" name="doFogOfWar" value="true" />
           </div>

           <div class="formItem">
               <label for="doBounty">Daily bounty</label>
               <input type="hidden" name="doBounty" value="false" />
               <input id="doBounty" type="checkbox" name="doBounty" value="true" checked />
           </div>

           <div class="formItem">
               <label for="allowAlwaysJoin">Allow always join</label>
               <input type="hidden" name="allowAlwaysJoin" value="false" />
               <input id="allowAlwaysJoin" type="checkbox" name="allowAlwaysJoin" value="true" />
           </div>

           <script>
               (function () {
                   const mode = document.getElementById('doActionQueue');
                   const broadcastRow = document.getElementById('broadcastRow');
                   function syncBroadcast() {
                       broadcastRow.style.display = mode.value === 'true' ? '' : 'none';
                   }
                   mode.addEventListener('change', syncBroadcast);
                   syncBroadcast();
               })();
           </script>

           <div class="formItem">

<!--           <label for="password">Optional Passphrase: </label>-->
<!--           <input id="password" name="password"/>-->
           </div>


           <%- include('../../partials/player_creation_card.ejs') %>

           <button type="submit">Create</button>
       </form>
   </div>
</div>
</body>

<style>
    input, select {
        float:right;
    }
</style>

<%- include('../../partials/footer.html') %>